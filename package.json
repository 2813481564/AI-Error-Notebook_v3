{
  "name": "ai-error-notebook",
  "private": true,
  "version": "3.0.0",
  "description": "AI 智能错题本：拍照录入错题，AI 诊断错因、生成变式题与学情报表，支持教务/教学/学生多角色协同。",
  "keywords": [
    "错题本",
    "AI",
    "教育",
    "学情分析",
    "React",
    "Express",
    "SQLite",
    "Gemini",
    "OpenAI",
    "education",
    "error-notebook"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2813481564/AI-Error-Notebook_v3.git"
  },
  "homepage": "https://github.com/2813481564/AI-Error-Notebook_v3#readme",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.10.0",
    "date-fns": "^4.2.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html-to-image": "^1.11.13",
    "katex": "^0.16.47",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^8.0.8",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-image-crop": "^11.1.2",
    "recharts": "^3.8.1",
    "sharp": "^0.35.2",
    "uuid": "^14.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
